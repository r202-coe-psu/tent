# Copy to tests/.env. When a value is unset here, frontend/.env is read too.

# CouchDB server admin — creates the throwaway test accounts and cleans up after the run.
COUCHDB_ADMIN_URL=http://admin:password@localhost:5984

# Two seeded shelters (frontend: `pnpm seed`). A is where writes are tried; B is the "other shelter".
TENT_SHELTER_A=SH001
TENT_SHELTER_B=SH002

# FastAPI for the external API suite (api/external-api). Falls back to FASTAPI_INTERNAL_URL,
# then http://localhost:9000. EXTERNAL_API_SECRET is the BFF's Bearer for /v1/admin and /public/v1.
# FASTAPI_URL=http://localhost:9000
EXTERNAL_API_SECRET=dev-external-secret

# Optional: FastAPI's partner JWT signing key (repo-root .env), to test an expired token.
# THIRDPARTY_JWT_SIGNING_KEY=
# Optional: an nginx edge built from nginx/ (staging, or a local container) for edge-routing.
# EDGE_BASE_URL=http://localhost:8088

# These tests write throwaway docs and accounts (and issue, then revoke, API keys). A non-localhost CouchDB is refused
# unless this is exactly "true" — set it only for staging, never for production.
# ALLOW_REMOTE_WRITES=true
