meta {
  name: EXT-009 Cancel booking
  type: http
  seq: 3
}

post {
  url: {{base_url}}/public-api/external/bookings/:booking_id/cancel
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

params:path {
  booking_id: {{booking_id}}
}

body:json {
  {
    "reason": "{{cancel_reason}}"
  }
}

docs {
  EXT-009 — ยกเลิกการจอง

  Scope: booking-write
  Method: POST /public-api/external/bookings/{booking_id}/cancel

  ใช้ booking_id จาก EXT-008
  body ไม่บังคับ ส่งว่างได้ reason ยาวไม่เกิน 200 ตัวอักษร

  ยกเลิกได้เฉพาะ booking ของ client ตัวเอง และเฉพาะตอนผู้จองยังไม่รายงานตัวที่ศูนย์
  200 ได้ booking_status CANCELLED
  ยกเลิกซ้ำ ยกเลิกของที่ถูกปฏิเสธแล้ว หรือผู้จองรายงานตัวแล้ว ได้ 409 booking_not_cancellable
  ไม่พบหรือเป็นของ client อื่นได้ 404 booking_not_found

  Error: 401 invalid_token · 403 insufficient_scope · 422 validation_error
}
