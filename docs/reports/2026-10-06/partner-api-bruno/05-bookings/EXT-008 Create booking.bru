meta {
  name: EXT-008 Create booking
  type: http
  seq: 1
}

post {
  url: {{base_url}}/public-api/external/bookings
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "location_code": "{{location_code}}",
    "cid": "{{cid}}",
    "first_name": "{{first_name}}",
    "last_name": "{{last_name}}",
    "phone": "{{phone}}"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.result && res.body.result.booking_id) {
    bru.setEnvVar("booking_id", res.body.result.booking_id);
  }
}

docs {
  EXT-008 — จองศูนย์

  Scope: booking-write ออกเป็นรายกรณี
  Method: POST /public-api/external/bookings

  เปลี่ยน cid ชื่อ และเบอร์ใน environment ให้เป็นข้อมูลจริงก่อนยิง
  ค่าที่ติดมาเป็นตัวอย่างจากเอกสาร as-built การยิงนี้สร้างการจองจริง

  ทุกฟิลด์บังคับ
  cid เป็นตัวเลข 13 หลักและผ่าน checksum ห้ามมีขีดหรือช่องว่าง
  phone รับ +66 ระบบแปลงเป็น 0 แล้วต้องเป็น 9 หรือ 10 หลัก
  ฟิลด์อื่นที่ส่งเพิ่มจะไม่ถูกเก็บ

  201 booking_status BOOKED แปลว่ารับเข้าคิวแล้ว ไม่ใช่ check-in
  สคริปต์เก็บ booking_id ไว้ให้ EXT-010 และ EXT-009
  ภายในประมาณ 10 วินาทีระบบลงทะเบียนผู้จองเข้าศูนย์ ผลสุดท้ายดูที่ EXT-010

  เลขบัตรเดิมที่ศูนย์เดิมได้ 409 duplicate_booking จองศูนย์อื่นได้
  ศูนย์ full ยังจองได้
  ศูนย์ closed หรือไม่รับจองล่วงหน้าได้ 409 location_not_bookable
  ไม่พบศูนย์หรือถูกปิดถาวรได้ 404 location_not_found

  Error: 401 invalid_token · 403 insufficient_scope · 422 validation_error
}
