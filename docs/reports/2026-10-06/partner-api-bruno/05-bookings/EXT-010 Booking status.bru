meta {
  name: EXT-010 Booking status
  type: http
  seq: 2
}

get {
  url: {{base_url}}/public-api/external/bookings/:booking_id
  body: none
  auth: inherit
}

params:path {
  @description('''BK-… จาก EXT-008 สคริปต์ของ EXT-008 เติมให้เมื่อยิงสำเร็จ''')
  booking_id: {{booking_id}}
}

docs {
  EXT-010 — ดูสถานะการจอง

  Scope: booking-write
  Method: GET /public-api/external/bookings/{booking_id}

  ยิงหลัง EXT-008 รอประมาณ 10 วินาทีแล้วค่อยยืนยันผล
  อ่านได้เฉพาะ booking ของ client ตัวเอง ของ client อื่นได้ 404 booking_not_found เช่นเดียวกับ id ที่ไม่มี

  booking_status
  - BOOKED การจองมีผล อยู่ในคิวหรือลงทะเบียนเข้าศูนย์แล้ว
  - CANCELLED ยกเลิกแล้ว เห็นทันทีแม้ระบบยังประมวลผลไม่เสร็จ
  - REJECTED ระบบปฏิเสธตอนลงทะเบียน

  reject_reason
  - null เมื่อจองมีผลหรือยกเลิกสำเร็จ
  - duplicate เมื่อ REJECTED เพราะเลขบัตรนี้มีที่ศูนย์เดียวกันแล้ว
  - not_cancellable เมื่อสถานะกลับเป็น BOOKED เพราะผู้จองไปรายงานตัวก่อนยกเลิกจะทัน

  เวลาเป็น ISO 8601 offset +07:00

  Error: 401 invalid_token · 403 insufficient_scope · 404 booking_not_found
}
