meta {
  name: EXT-007 Occupants
  type: http
  seq: 1
}

get {
  url: {{base_url}}/public-api/external/locations/:location_code/occupants
  body: none
  auth: inherit
}

params:path {
  location_code: {{location_code}}
}

params:query {
  @description('''เหตุผลในการเข้าถึง บังคับ ใช้บันทึกตาม PDPA''')
  purpose: {{occupants_purpose}}
  page: {{page}}
  @description('''สูงสุด 200''')
  limit: {{limit}}
}

docs {
  EXT-007 — รายละเอียดผู้พัก

  Scope: occupancy-pii-read ออกเป็นรายกรณี ไม่ได้อยู่ใน preset
  Method: GET /public-api/external/locations/{location_code}/occupants

  ต้องส่ง purpose ที่ไม่ว่าง ระบบตรวจ purpose ก่อน scope
  ทุกครั้งถูกบันทึก audit ไม่ว่าจะผ่านหรือไม่

  สำเร็จได้รายการผู้พักสถานะ active นามสกุลถูกปิด และเป็นช่วงอายุ ไม่ใช่เลขบัตร

  Error: 400 missing_purpose
  Error: 403 insufficient_scope
  Error: 404 location_not_found
  Error: 401 invalid_token
}
