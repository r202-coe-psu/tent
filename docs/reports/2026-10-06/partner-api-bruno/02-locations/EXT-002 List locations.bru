meta {
  name: EXT-002 List locations
  type: http
  seq: 1
}

get {
  url: {{base_url}}/public-api/external/locations
  body: none
  auth: inherit
}

params:query {
  @description('''หน้าที่ต้องการ เริ่มที่ 1''')
  page: {{page}}
  @description('''จำนวนต่อหน้า สูงสุด 200''')
  limit: {{limit}}
  @description('''กรอง location_status: open, closed, full, standby''')
  ~status: open
  @description('''คืนเฉพาะ updated_at >= ค่านี้ เป็น ISO-8601''')
  ~updated_since: 2026-08-11T00:00:00+07:00
  @description('''true เพื่อรวมศูนย์ที่ถูกปิดถาวร is_active=false''')
  ~include_inactive: false
}

docs {
  EXT-002 — รายการสถานที่

  Scope: location-read
  Method: GET /public-api/external/locations

  ค่าเริ่มต้นคืนเฉพาะ is_active=true
  ศูนย์ที่ปิดปฏิบัติการ (location_status=closed) ยัง is_active=true อยู่
  เปิด include_inactive เมื่อต้องการรายการที่ถูกถอนจากทะเบียน

  นำ location_code จาก result ไปใส่ตัวแปร environment ก่อนยิง EXT-003 เป็นต้นไป
  ฟิลด์ภูมิศาสตร์และผู้ติดต่อเป็น null ได้

  Error: 401 invalid_token · 403 insufficient_scope
}
