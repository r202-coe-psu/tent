meta {
  name: EXT-001 Get token
  type: http
  seq: 1
}

post {
  url: {{base_url}}/public-api/external/token
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "grant_type": "client_credentials",
    "client_id": "{{client_id}}",
    "client_secret": "{{client_secret}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.access_token) {
    bru.setEnvVar("access_token", res.body.access_token);
  }
}

docs {
  EXT-001 — ขอ access token

  Scope: ไม่ใช้ Bearer
  Method: POST /public-api/external/token

  กรอก client_id และ client_secret ใน environment ก่อนยิง
  grant_type ต้องเป็น client_credentials เท่านั้น

  สำเร็จ 200 ได้ access_token, token_type Bearer, expires_in ประมาณ 3600, module_name และ scopes
  สคริปต์เก็บ access_token ไว้ให้ request อื่น ไม่มี refresh token

  Error: 400 unsupported_grant_type เมื่อ grant_type ไม่ใช่ client_credentials
  Error: 401 invalid_client เมื่อ id ไม่รู้จัก ไม่ active หรือ secret ผิด
}
