pipeline {
    agent { label 'mgmt' }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds(abortPrevious: true)
        buildDiscarder(logRotator(numToKeepStr: '20', daysToKeepStr: '14'))
        // @release + @smoke remote set can take 15–30 min (playwright globalTimeout 30m).
        timeout(time: 40, unit: 'MINUTES')
        timestamps()
    }

    parameters {
        string(name: 'DEPLOY_COMMIT', defaultValue: '', description: 'Exact commit deployed to Staging')
        string(name: 'STAGING_URL', defaultValue: 'https://shelter.importstar.dev', description: 'Staging base URL')
    }

    environment {
        // GitHub commit status context required on `main` branch protection (owner enables it).
        GITHUB_STATUS_CONTEXT = 'staging/e2e'
        GITHUB_REPO = 'r202-coe-psu/tent'
    }

    stages {
        stage('Validate and Checkout Deployed Commit') {
            steps {
                checkout scm
                script {
                    if (!(params.DEPLOY_COMMIT ==~ /[0-9a-f]{40}/)) {
                        error('DEPLOY_COMMIT must be a full 40-character lowercase Git SHA')
                    }
                    if (!(params.STAGING_URL ==~ /https:\/\/[^\s\/]+\/?/)) {
                        error('STAGING_URL must be an HTTPS origin without a path')
                    }
                }
                withEnv(["DEPLOY_COMMIT=${params.DEPLOY_COMMIT}"]) {
                    sh '''
                        set -eu
                        git fetch --no-tags origin +refs/heads/staging:refs/remotes/origin/staging
                        git cat-file -e "${DEPLOY_COMMIT}^{commit}"
                        git merge-base --is-ancestor "$DEPLOY_COMMIT" origin/staging
                        git checkout --detach "$DEPLOY_COMMIT"
                        test "$(git rev-parse HEAD)" = "$DEPLOY_COMMIT"
                    '''
                }
            }
        }

        stage('Report Pending GitHub Status') {
            steps {
                script {
                    setGitHubCommitStatus('pending', 'Staging E2E running')
                }
            }
        }

        stage('Wait for Staging Readiness') {
            steps {
                withEnv(["STAGING_URL=${params.STAGING_URL.replaceAll('/+$', '')}"]) {
                    sh '''
                        set -eu
                        health_body="$(mktemp)"
                        trap 'rm -f "$health_body"' EXIT
                        deadline=$(( $(date +%s) + 120 ))

                        while [ "$(date +%s)" -lt "$deadline" ]; do
                            status="$(curl --silent --show-error --output "$health_body" --write-out '%{http_code}' --max-time 10 "$STAGING_URL/api/health" || true)"
                            body="$(tr -d '\r\n' < "$health_body")"
                            if [ "$status" = '200' ] && [ "$body" = '{"ok":true,"service":"frontend"}' ]; then
                                echo 'Staging health check passed.'
                                exit 0
                            fi
                            sleep 5
                        done

                        echo 'Staging did not return the expected health payload within 120 seconds.' >&2
                        exit 1
                    '''
                }
            }
        }

        stage('Run Staging E2E (@release + @smoke)') {
            steps {
                withCredentials([
                    file(credentialsId: 'tent-staging-e2e-env', variable: 'E2E_ENV_FILE')
                ]) {
                    withEnv([
                        'CI=true',
                        'ALLOW_REMOTE_WRITES=true',
                        "E2E_BASE_URL=${params.STAGING_URL.replaceAll('/+$', '')}"
                    ]) {
                        sh 'scripts/run-staging-e2e.sh'
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                setGitHubCommitStatus('success', 'Staging E2E passed')
            }
        }
        failure {
            script {
                setGitHubCommitStatus('failure', 'Staging E2E failed')
            }
        }
        aborted {
            script {
                setGitHubCommitStatus('error', 'Staging E2E aborted')
            }
        }
        always {
            junit allowEmptyResults: true, testResults: 'frontend/test-results/staging/junit.xml'
            publishHTML(target: [
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'frontend/playwright-report/staging',
                reportFiles: 'index.html',
                reportName: 'Staging E2E Report'
            ])
            archiveArtifacts allowEmptyArchive: true, artifacts: 'frontend/test-results/staging/**/*,frontend/playwright-report/staging/**/*', fingerprint: false
            cleanWs(cleanWhenNotBuilt: false,
                    deleteDirs: true,
                    disableDeferredWipeout: true,
                    notFailBuild: true)
        }
    }
}

/**
 * Post a commit status on params.DEPLOY_COMMIT via the GitHub REST API.
 * Credential: secret text `tent-github-status-token` (fine-grained or classic PAT
 * with `statuses:write` on r202-coe-psu/tent). Owner must provision this before
 * the status appears; missing credential fails the status step (and thus the job).
 */
void setGitHubCommitStatus(String state, String description) {
    def sha = params.DEPLOY_COMMIT?.trim()
    if (!(sha ==~ /[0-9a-f]{40}/)) {
        echo "Skipping GitHub status (${state}): DEPLOY_COMMIT is not a full SHA"
        return
    }
    def targetUrl = env.BUILD_URL ?: ''
    withCredentials([string(credentialsId: 'tent-github-status-token', variable: 'GITHUB_TOKEN')]) {
        withEnv([
            "STATUS_STATE=${state}",
            "STATUS_DESC=${description}",
            "STATUS_SHA=${sha}",
            "STATUS_CONTEXT=${env.GITHUB_STATUS_CONTEXT}",
            "STATUS_REPO=${env.GITHUB_REPO}",
            "STATUS_TARGET_URL=${targetUrl}"
        ]) {
            sh '''
                set -eu
                payload="$(mktemp)"
                trap 'rm -f "$payload"' EXIT
                python3 - <<'PY' > "$payload"
import json, os
print(json.dumps({
    "state": os.environ["STATUS_STATE"],
    "description": os.environ["STATUS_DESC"][:140],
    "context": os.environ["STATUS_CONTEXT"],
    "target_url": os.environ.get("STATUS_TARGET_URL") or None,
}))
PY
                http_code="$(curl --silent --show-error --output /tmp/gh-status-body.json --write-out '%{http_code}' \
                    -X POST \
                    -H "Accept: application/vnd.github+json" \
                    -H "Authorization: Bearer ${GITHUB_TOKEN}" \
                    -H "X-GitHub-Api-Version: 2022-11-28" \
                    -H "Content-Type: application/json" \
                    --data @"$payload" \
                    "https://api.github.com/repos/${STATUS_REPO}/statuses/${STATUS_SHA}")"
                if [ "$http_code" != "201" ]; then
                    echo "GitHub statuses API returned HTTP ${http_code}:" >&2
                    cat /tmp/gh-status-body.json >&2 || true
                    exit 1
                fi
                echo "GitHub commit status ${STATUS_STATE} set on ${STATUS_SHA} (${STATUS_CONTEXT})"
            '''
        }
    }
}
