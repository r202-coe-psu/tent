# scanner-client settings. Copy to `.env` next to scanner-client.exe (or scanner-client/ when
# running from source). Process environment variables override this file. No secrets here.

# Shelter web app origin only: http(s)://host[:port], no path/query/credentials.
# Asked in the browser window on every start: it opens this value (https://shelter.psu.ac.th when
# unset) unless staff press "เปลี่ยน domain" and type another; the answer is saved here.
# http is allowed only for localhost / loopback and LAN IPs (10.x, 172.16-31.x, 192.168.x,
# 169.254.x, fc00::/7, fe80::/10), e.g. the shelter edge server: http://192.168.1.10
SHELTER_URL=https://shelter.psu.ac.th

# Optional. First page opened when the app starts. Must start with "/". Default: staff login.
# START_PATH=/admin-login

# Optional. Walk-in page the card data is sent to. Must start with "/".
# WALK_IN_PATH=/onsite/people/new

# Optional. Browser to open: msedge | chrome | chromium (bundled Chromium).
# Default: msedge on Windows, chromium elsewhere.
# BROWSER_CHANNEL=msedge

# Optional. Part of the PC/SC reader name (case-insensitive) to use, e.g. "ACS".
# Default: first reader that is not a virtual smart card (Windows Hello / TPM).
# CARD_READER_NAME=

# Optional. true keeps the staff login between runs (persistent browser profile);
# false (default) forgets the login when the browser window is closed. true/false/1/0/yes/no.
# KEEP_LOGIN=false

# Optional. Seconds between card-slot polls, 0.2 to 10. Default 0.5.
# POLL_INTERVAL=0.5
