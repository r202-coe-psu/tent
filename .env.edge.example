# Edge appliance @ศูนย์ (docker-compose.edge.yml) — บน edge server: cp .env.edge.example .env แล้วแก้ค่า
# รหัสผ่านทุกตัวในไฟล์นี้: ห้ามมี " \ @ : / # % ? หรือช่องว่าง (ถูกใส่ลงใน URL และ JSON ตรง ๆ)
# แนะนำให้สร้างด้วย: openssl rand -hex 24

# Admin ของ CouchDB ที่ edge — คนละรหัสกับ central
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me-edge-admin

# ศูนย์ที่ edge นี้ให้บริการ (role shelter:SH001, DB shelter_sh001)
SHELTER_CODE=SH001

# ที่อยู่ central สำหรับ replication: path /sync บน domain ของแอป (host nginx `location /sync/` — docs/couchdb-replication/SETUP-CENTRAL.md ขั้น 4B)
# lab ไม่มี cert/nginx: SYNC_URL=http://<IP central>:5984
# ระวัง: ตอน cutover (LAN DNS ชี้ domain แอปมาที่ edge) job จะยิงเข้า edge ตัวเองและล้ม จนกว่าจะ cutback —
# หลัง cutback edge-watchdog เตะ job ให้เอง (docs/couchdb-replication/SETUP-EDGE.md)
SYNC_URL=https://app.example.com/sync

# credential ที่ edge ใช้คุยกับ central — user ต่อศูนย์ (role repl:<SHELTER_CODE>) ใช้ชุดเดียวกับทุก job
# (registry / catalog / shelter_<code> / edge_users_<code>) — ไม่ใช่ central admin
# สร้างที่ central: scripts/central-repl-user.sh <CODE> (เช่น SH001) แล้วเอา user/password ที่ได้มาใส่ที่นี่
# edge-init ตรวจ GET /_session ก่อนสร้าง job: ต้องมี role repl:<SHELTER_CODE> และต้องไม่เป็น _admin
EDGE_REPL_USER=repl_sh001
EDGE_REPL_PASSWORD=change-me-edge-repl

# Staff SPA — domain เดียวกับ central (cutover ทำที่ LAN DNS)
PUBLIC_ORIGIN=https://app.example.com
# FRONTEND_IMAGE=tent/frontend:latest

# EDGE_MODE=true ถูกตั้งให้ frontend ใน docker-compose.edge.yml แล้ว (CR-171 FR-13) — ไม่ต้องใส่ใน .env
# เปิดแล้ว BFF ปฏิเสธทุกเส้นที่เขียน _users ("แก้ไขบัญชีได้เฉพาะที่ระบบกลาง") · central ไม่ตั้ง = ปิด

# nginx ของ edge bind ที่ IP ฝั่ง LAN
EDGE_LAN_IP=127.0.0.1
EDGE_HTTP_PORT=80

# CouchDB ของ edge: admin port (127.0.0.1 เท่านั้น) และ data dir
# EDGE_COUCHDB_PORT=5984
# EDGE_COUCHDB_DATA=../deployment/tent-edge/couchdb/data

# Watchdog: restarts replication jobs stuck in CouchDB's exponential backoff after an outage
# (scripts/edge-watchdog.sh). Defaults shown; WATCHDOG_DRY_RUN=1 = log only.
# WATCHDOG_INTERVAL=60
# WATCHDOG_MIN_ERRORS=3
# WATCHDOG_COOLDOWN=300
# WATCHDOG_DRY_RUN=0
