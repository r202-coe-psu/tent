COUCHDB_USER=admin
COUCHDB_PASSWORD=password

# Roleless CouchDB user the frontend BFF uses for anonymous public writes
# (public booking — CR-070/T-71 — and the donation courier PATCH), so those
# never touch the admin credentials above. `pnpm seed` creates the user;
# `pnpm redeploy:access --write --confirm` grants it on every shelter DB.
# REQUIRED on staging/production — the BFF fails closed without it.
COUCHDB_PUBLIC_WRITER_USER=public_writer
COUCHDB_PUBLIC_WRITER_PASSWORD=change-me-in-staging

# MongoDB public read-model (worker + FastAPI). Use service name `mongodb` in compose, not localhost.
# Host-run worker/backend: override with mongodb://localhost:27017/tentdb.
DATABASE_URI=mongodb://mongodb:27017/tentdb
# Required on staging — set real values in the server .env (do not commit secrets).
SECRET_KEY=change-me-in-staging
EXTERNAL_API_SECRET=change-me-in-staging
# Signs partner OAuth2 client-credentials JWTs (EXT-001, ADR 0002) — separate from SECRET_KEY.
THIRDPARTY_JWT_SIGNING_KEY=change-me-in-staging

# Staging / production
PUBLIC_ORIGIN=http://localhost
PUBLIC_APP_TITLE=Tent
NGINX_PORT=80

# Nginx configuration
NGINX_HOST=127.0.0.1

# Configuration for exposing CouchDB to host (used when Nginx runs on host)
COUCHDB_BIND_IP=127.0.0.1
COUCHDB_PORT=5984

# Configuration for exposing SvelteKit frontend to host (used when Nginx runs on host)
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=3000

# Frontend Node cluster (adapter-node via server/cluster.mjs). Default 3; clamped
# to the container's CPU count so a 1-vCPU host never over-forks.
#
# Where to scale in this stack:
# 1. WEB_CONCURRENCY — BFF /api/* + SPA concurrency inside the frontend container
# 2. FastAPI (uvicorn workers) — public/external API throughput
# 3. Docker replicas + nginx upstream — when one host/container is not enough
# 4. CouchDB / Mongo — data plane (more Node workers will not help a DB bottleneck)
WEB_CONCURRENCY=3

# FastAPI bind (docker-compose.staging.no-nginx.yml — host nginx proxies to this)
FASTAPI_BIND_IP=127.0.0.1
FASTAPI_PORT=9000


# Google reCAPTCHA Enterprise — site key is baked into the frontend image at build time
# (PUBLIC_*); project ID & service account key in secrets/ are runtime-only on the frontend BFF.
PUBLIC_RECAPTCHA_SITE_KEY=6LegX74tAAAAALRTKdaHzB4bLc6iayu8OjlPf9MW
RECAPTCHA_PROJECT_ID=smart-shelter-508719
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-recaptcha-key.json

# Google OAuth — staff step-up MFA (CR-124). Runtime on frontend BFF only
# (same pattern as SECRET_RECAPTCHA_KEY). Never PUBLIC_GOOGLE_*.
# Redirect URI is derived as {ORIGIN}/api/v1/auth/oauth/google/callback from
# PUBLIC_ORIGIN (compose sets ORIGIN). Register that URL in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ThaID OAuth (BORA Digital ID) — staff step-up MFA & linked login. Runtime on frontend BFF only.
# Never PUBLIC_THAID_*.
# Redirect URI is derived as ${PUBLIC_ORIGIN}${THAID_OAUTH_CALLBACK_PATH} in compose
# unless THAID_OAUTH_REDIRECT_URI is explicitly specified.
THAID_OAUTH_CLIENT_ID=
THAID_OAUTH_CLIENT_SECRET=
THAID_OAUTH_AUTH_URL=https://imauthsbx.bora.dopa.go.th/api/v2/oauth2/auth/
THAID_OAUTH_TOKEN_URL=https://imauthsbx.bora.dopa.go.th/api/v2/oauth2/token/
THAID_OAUTH_CALLBACK_PATH=/api/v1/auth/oauth/thaid/callback
# Optional full redirect URI override (defaults to ${PUBLIC_ORIGIN}${THAID_OAUTH_CALLBACK_PATH}):
# THAID_OAUTH_REDIRECT_URI=https://shelter.importstar.dev/api/v1/auth/oauth/thaid/callback

# Optional OAuth Scope for Citizen Registration autofill (defaults to "openid pid name birthdate address")
# THAID_OAUTH_SCOPE=openid pid name birthdate address
