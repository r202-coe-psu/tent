[Unit]
Description=Tent print agent (XP-365B)
After=network-online.target cups.service
Wants=network-online.target cups.service

[Service]
User=tent-printer
Group=lp
WorkingDirectory=/opt/tent/printer
EnvironmentFile=/opt/tent/printer/.env
ExecStart=/opt/tent/printer/.venv/bin/python -m printer
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
