# https:// by default. Plain http:// is accepted for loopback (localhost, 127.0.0.0/8, ::1),
# or for any host (LAN IP / edge domain without TLS) when TENT_ALLOW_HTTP=1.
TENT_BASE_URL=https://<deployment-host>
# Set to 1 only when the server has no HTTPS (e.g. edge on LAN): DEVICE_SECRET is sent unencrypted.
# TENT_ALLOW_HTTP=0
DEVICE_ID=printer-sh001-reg1
DEVICE_SECRET=sk_print_...
PRINTER_NAME=tent_xprinter
# PRINT_PPI=203                 must match KIOSK_PRINT_PPI of the kiosk
# PRINT_JOB_TIMEOUT_SEC=30      wait for CUPS completed per label
# IDLE_BACKOFF_SEC=5            when the queue is not ready
# ERROR_BACKOFF_MAX_SEC=60      max backoff on network loss / 5xx / 401
# Print a slip (name, device_id, shelter, version, IP) once at start; 0 = off.
# Keep comments on their own line: systemd EnvironmentFile has no trailing comments.
BOOT_SLIP=1
