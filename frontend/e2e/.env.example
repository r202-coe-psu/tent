# Staging / remote Playwright (copied into Jenkins credential tent-staging-e2e-env).
E2E_BASE_URL=https://shelter.importstar.dev
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=password

# Master switch for @critical (live-write) suites against E2E_BASE_URL — see
# CAN_WRITE in helpers/e2e-env.ts. This file IS the tent-staging-e2e-env credential
# content, so setting this here (not in Jenkinsfile.e2e-staging) is what actually
# turns staging writes on; flipping it is a credential change, reviewed by whoever
# owns that secret, not a pipeline code change.
# Never copy this line into tent-prod-e2e-env / a prod .env — production must
# stay read-only. (No @critical suite carries @prod, so playwright.prod.config.ts
# would never select one anyway, but don't rely on that as the only guard.)
ALLOW_REMOTE_WRITES=true

# Read-only public fixtures (required when E2E_BASE_URL is set — see helpers/e2e-env.ts).
# Provision once via staff UI; names must be fictitious and start with the documented markers.
E2E_SEARCH_SHELTER_NAME=E2E Search Fixture
E2E_SEARCH_PREFIX=ทดสอบE2E
E2E_SEARCH_PHONE=0800000001
E2E_SEARCH_NATIONAL_ID=0123456789012
E2E_SEARCH_PASSPORT=ZZ0000001
E2E_SHELTERS_MARKER=E2Eกรอง

# Optional: FastAPI origin for staff-only teardown helpers (local default :9000).
# Required on staging for suites that assert the public projection
# (system-admin-shelter.test.ts, public-pre-register-flow.test.ts W5) — point it
# at the real staging FastAPI origin, not localhost.
# E2E_FASTAPI_URL=http://localhost:9000

# Required to unlock @critical (live-write) suites on staging — see
# e2e/README.md §9.C "Owner follow-ups". Never the production admin password;
# a staging-only CouchDB instance.
# COUCHDB_ADMIN_URL embeds the CouchDB server-admin credentials used by
# bootstrapAdminSession() (helpers/couch.ts) to mint a session directly, the way
# every @critical suite (system-admin-shelter, onsite-stations-flow,
# back-office-evacuee-management, public-home-flow, public-search-flow,
# public-shelters-filter, public-pre-register-flow W5) provisions its own E2E
# shelter. Falls back to http://admin:password@localhost:5984 when unset, which
# is wrong inside the Jenkins container — every live-write test would fail.
COUCHDB_ADMIN_URL=http://admin:password@staging-couch-host:5984

# Limited-permission `public_writer` CouchDB user (see repo-root .env.example /
# frontend/.env.example) — required only for public-pre-register-flow.test.ts W5
# (shelter booking via the anonymous public write path). W5 test.skips itself
# when this is unset; the other @critical suites don't need it.
# COUCHDB_PUBLIC_WRITER_URL=http://public_writer:change-me-in-staging@staging-couch-host:5984
