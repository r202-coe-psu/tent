PUBLIC_APP_TITLE=Tent

# Public CouchDB base URL (NO credentials — this value is bundled into the
# browser). Used for cookie-authenticated session/sync requests.
PUBLIC_COUCHDB_URL=http://localhost:5984

# Vite dev proxy path — keeps CouchDB same-origin so session cookies work.
# Set to empty string to disable (e.g. production behind nginx).
PUBLIC_COUCH_PROXY=/couch

# FastAPI — BFF talks here directly (server-only). Prefer FASTAPI_INTERNAL_URL.
# Browser must NOT call FastAPI; use same-origin `/api/public/v1/*` (CR-063).
PUBLIC_FASTAPI_PROXY=http://localhost:9000

# Server-only BFF → FastAPI. Docker Compose: http://fastapi:9000.
FASTAPI_INTERNAL_URL=http://localhost:9000

# Shared with FastAPI EXTERNAL_API_SECRET — BFF sends Bearer on all /public/v1 routes.
EXTERNAL_API_SECRET=change-me-in-staging

# Server-only admin URL WITH embedded credentials. Never bundled into the
# browser (no PUBLIC_ prefix); used only by dev-server /api/admin/** routes.
# Match COUCHDB_USER/COUCHDB_PASSWORD from the repo-root .env.
COUCHDB_ADMIN_URL=http://admin:password@localhost:5984

# Server-only limited-permission writer for anonymous public writes (public
# booking POST — CR-070/T-71 — and the donation courier PATCH). Roleless: it is
# granted per-shelter access as a plain `_security.members.names` entry, so every
# write still passes through `_design/access` validate_doc_update, unlike admin
# writes which bypass it. REQUIRED in production — `putAsPublicWriter` throws
# when it is missing outside dev (dev falls back to the admin URL above).
# `pnpm seed` creates the user; `pnpm redeploy:access --write --confirm` grants it
# on every existing shelter DB.
COUCHDB_PUBLIC_WRITER_URL=http://public_writer:public-writer-password@localhost:5984

# Server-only bearer secret shared with the private shelter import worker.
# Must match the repo-root SHELTER_IMPORT_WORKER_TOKEN in Docker deployments.
SHELTER_IMPORT_WORKER_TOKEN=replace-with-a-random-secret

# Google reCAPTCHA v3 — site key is PUBLIC (bundled into the browser); secret is
# server-only (BFF verify). Use separate keys per domain in Google Console.
#! ตอนนี้ยังผูกกับเมลล์ของผู้พัฒนาอยู่ ถ้าจะใช้ต้องเปลี่ยนเป็นคีย์ที่ได้จาก Google reCaptcha ของคทีม
# Google reCAPTCHA Enterprise — site key is PUBLIC (bundled into the browser);
# project ID and service account credentials are used by the server-only BFF for assessments.
PUBLIC_RECAPTCHA_SITE_KEY=6LegX74tAAAAALRTKdaHzB4bLc6iayu8OjlPf9MW
RECAPTCHA_PROJECT_ID=smart-shelter-508719
GOOGLE_APPLICATION_CREDENTIALS=../secrets/gcp-recaptcha-key.json

# Production Docker only (not used by `pnpm dev`): adapter-node cluster size.
# Set on the compose frontend service / repo-root `.env` as WEB_CONCURRENCY.
# See repo-root `.env.example` for the scale map (Node → FastAPI → replicas → DB).

# Google OAuth — staff step-up MFA (CR-124). Server-only on the frontend BFF.
# Never PUBLIC_GOOGLE_*. Redirect defaults to {origin}/api/v1/auth/oauth/google/callback
# (register that URL in Google Cloud Console). Optional override for local only:
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/v1/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
