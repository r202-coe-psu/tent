# URL ของ Tent Server (เช่น http://localhost:5173 หรือ https://tent.your-domain.com)
TENT_BASE_URL=http://localhost:5173

# Device ID และ Secret ที่สร้างจากหน้า Back Office (/portal/system-management/scanners)
DEVICE_ID=SCAN-01
DEVICE_SECRET=sk_scan_your_secret_here

# การแสดงผลของ Playwright (chromium, firefox, webkit)
BROWSER=chromium

# (ไม่บังคับ) กำหนด Path ของเบราว์เซอร์ในระบบ เช่น สำหรับ Raspberry Pi: /usr/bin/chromium-browser
# BROWSER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# DEBUG: true = เปิดเป็นหน้าต่างทั่วไป (แนวตั้ง), false = Kiosk เต็มหน้าจอ
DEBUG=true

# ขนาดหน้าจอแนวตั้ง (สำหรับโหมด DEBUG Windowed: ค่าเริ่มต้น 540x960 หรือ 1080x1920)
WINDOW_WIDTH=540
WINDOW_HEIGHT=960

# หน่วงเวลา Polling ตรวจจับบัตร (วินาที)
POLL_INTERVAL=0.5
