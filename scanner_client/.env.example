# URL ของ Tent Server (แนะนำ HTTPS สำหรับ deployment; HTTP ใช้ทดสอบได้)
TENT_BASE_URL=https://<deployment-host>
# HTTP ใช้ได้อัตโนมัติเฉพาะ loopback/private LAN (เช่น edge บน LAN); สำหรับ hostname อื่นต้องตั้งค่านี้เป็น true จึงจะใช้ HTTP ได้ (ไม่แนะนำนอกจาก dev)
# ALLOW_INSECURE_HTTP=true

# คัดลอกค่าจริงที่แสดงครั้งเดียวจาก System Management scanner-create flow
DEVICE_ID=<device-id>
DEVICE_SECRET=<one-time-key>

# การแสดงผลของ Playwright (chromium, firefox, webkit)
BROWSER=chromium

# (ไม่บังคับ) กำหนด Path ของเบราว์เซอร์ในระบบ เช่น สำหรับ Raspberry Pi / Debian: /usr/bin/chromium
# BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
# (silent print ต้องใช้ /usr/bin/chromium เพื่อให้ Chromium policy ใน /etc/chromium/policies มีผล)

# DEBUG: false = Kiosk เต็มหน้าจอ (ค่าเริ่มต้นสำหรับ Kiosk), true = เปิดเป็นหน้าต่างทั่วไป
DEBUG=false

# HEADLESS: false = เปิดหน้าต่าง UI บนจอภาพ, true = รันแบบไม่มี GUI (เช่น เครื่อง Server ที่ไม่มีจอ)
HEADLESS=false

# KIOSK_SILENT_PRINT: ใส่ --kiosk-printing ให้ window.print() ของ browser (ไม่เกี่ยวกับปุ่ม "พิมพ์ QR Code"
#   ซึ่งส่งเข้า CUPS โดยตรงเสมอ — ดู PRINTER_NAME)
#   ไม่ตั้งค่า = เปิดในโหมด Kiosk, ปิดในโหมด DEBUG
#   true      = เปิดทั้งสองโหมด (ใช้ทดสอบบนเครื่อง dev แบบหน้าต่าง)
#   false     = ปิดทั้งสองโหมด
# KIOSK_SILENT_PRINT=

# ชื่อ CUPS queue ของเครื่องพิมพ์ label (ต้องตรงกับที่ setup_printer.sh สร้าง); start_kiosk.sh จะ enable ให้ทุกครั้งที่เปิด
# ปุ่ม "พิมพ์ QR Code" ส่ง label เข้า queue นี้ด้วย lp โดยตรงเสมอ (ไม่มี print dialog ทุกโหมด ไม่ต้องตั้งค่าเพิ่ม)
PRINTER_NAME=tent_xprinter

# (ไม่บังคับ) ปรับระดับ Zoom / Scale ของหน้าจอ (เช่น 0.75 สำหรับจอเล็ก 1024x600 หรือ 7 นิ้ว เพื่อให้แสดงผลพอดีไม่ล้นจอ)
# DEVICE_SCALE_FACTOR=0.75

# (ไม่บังคับ) กำหนด DISPLAY เช่น :0 กรณีรันคำสั่งผ่าน SSH
# DISPLAY=:0

# ขนาดหน้าต่างสำหรับโหมด DEBUG Windowed (เช่น 1024x600 สำหรับ ED-MONITOR-101C หรือ 540x960 สำหรับแนวตั้ง)
WINDOW_WIDTH=1024
WINDOW_HEIGHT=600

# หน่วงเวลา Polling ตรวจจับบัตร (วินาที)
POLL_INTERVAL=0.5

# --- ฮาร์ดแวร์เฉพาะเครื่อง (ตู้ใหญ่ kiosk3) — ไม่ตั้ง = ทำงานเหมือนตู้ Raspberry Pi เดิม ---
# รายละเอียดและขั้นตอนครั้งแรก (group lp, udev rule): README หัวข้อ "ตู้ใหญ่ kiosk3"

# เครื่องพิมพ์: cups (ค่าเริ่มต้น, ใช้ PRINTER_NAME ด้านบน) | escpos (เขียนตรงเข้า /dev/usb/lpN)
# PRINTER_BACKEND=escpos
# เมื่อ escpos ต้องมี PRINTER_USB_ID (VID:PID, หา lpN ให้เองทุกครั้งที่พิมพ์) หรือ PRINTER_DEVICE (path ตรง ๆ)
# PRINTER_USB_ID=28e9:5812
# PRINTER_DEVICE=/dev/usb/lp3
# ความกว้างหัวพิมพ์เป็น dots (384–832, หาร 8 ลงตัว); กระดาษ 80 มม. = 576
# PRINTER_WIDTH_DOTS=576

# วิธี "QR ลงทะเบียน" บนหน้าแรก kiosk: on (ค่าเริ่มต้น) | off (ซ่อนปุ่ม QR และเข้า /kiosk/qr ไม่ได้ — กลับหน้าแรก)
# ตั้งต่อเครื่อง เช่น ตู้ Raspberry Pi ที่ยังไม่ใช้สแกน QR; ไม่กระทบ ThaiD / บัตร / เบอร์โทร
# KIOSK_QR_CHECK_IN=off

# การอ่าน QR ที่หน้า /kiosk/qr: camera (ค่าเริ่มต้น) | reader (เครื่องอ่าน USB แบบ keyboard, ไม่เปิดกล้อง) | both
# ตู้ Raspberry Pi (กล้องสแกน QR)
# KIOSK_QR_INPUT=reader
# เลือกกล้อง (KIOSK_CAMERA_LABEL) / ปรับเครื่องอ่าน QR (KIOSK_QR_READER_MAX_GAP_MS): ดู README ตาราง kiosk3

# เครื่องอ่านบัตร: pcsc (ค่าเริ่มต้น, pcscd) | rfpro (โมดูล HID HOUSESmart)
# CARD_READER=rfpro
# CARD_READER_USB_ID=0483:4c43

# ตรวจใบหน้าเทียบรูปในชิปบัตร (ยังเป็นข้อเสนอ ดู docs/plans/kiosk-face-verification-implementation-plan.md)
# off (ค่าเริ่มต้น: ทุกอย่างทำงานเหมือนเดิม) | on (ตรวจ + แจ้งผล ไม่ผ่านต้องใช้ PIN เจ้าหน้าที่)
# ต้องรัน ./models/download_models.sh ก่อน และใช้กล้องตัวเดียวกับสแกน QR
# เกณฑ์ยังไม่ได้ calibrate กับรูปในชิปจริง — เปิด on เฉพาะตู้ทดสอบ ตู้ที่ให้บริการจริงคง off ไว้
# ผลตรวจยังไม่ถูกส่งไป server จนกว่า Phase 3 (schema/CR) จะเสร็จ
# KIOSK_FACE_CHECK=off
# เปิดเฉพาะบาง flow: check_in (ลงทะเบียนล่วงหน้า) , walk_in — ค่าเริ่มต้นคือทั้งสอง
# KIOSK_FACE_CHECK_FLOWS=check_in,walk_in
# ชุดเกณฑ์ (มีเวอร์ชัน) ค่าเริ่มต้น sface-opencv-default-v1
# KIOSK_FACE_THRESHOLD_PROFILE=sface-opencv-default-v1
# โฟลเดอร์ model: ไม่ต้องตั้ง — ค่าเริ่มต้นคือ scanner_client/models (ที่ download_models.sh โหลดลงให้)
# ตั้งเฉพาะเมื่อย้าย model ไปไว้นอก repo จริงๆ และโฟลเดอร์นั้นต้องมีไฟล์ครบ 4 ไฟล์
# KIOSK_FACE_MODELS_DIR=
