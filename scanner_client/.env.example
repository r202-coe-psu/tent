# URL ของ Tent Server (แนะนำ HTTPS สำหรับ deployment; HTTP ใช้ทดสอบได้)
TENT_BASE_URL=https://<deployment-host>

# คัดลอกค่าจริงที่แสดงครั้งเดียวจาก System Management scanner-create flow
DEVICE_ID=<device-id>
DEVICE_SECRET=<one-time-key>

# การแสดงผลของ Playwright (chromium, firefox, webkit)
BROWSER=chromium

# (ไม่บังคับ) กำหนด Path ของเบราว์เซอร์ในระบบ เช่น สำหรับ Raspberry Pi / Debian: /usr/bin/chromium
# BROWSER_EXECUTABLE_PATH=/usr/bin/chromium

# DEBUG: false = Kiosk เต็มหน้าจอ (ค่าเริ่มต้นสำหรับ Kiosk), true = เปิดเป็นหน้าต่างทั่วไป
DEBUG=false

# HEADLESS: false = เปิดหน้าต่าง UI บนจอภาพ, true = รันแบบไม่มี GUI (เช่น เครื่อง Server ที่ไม่มีจอ)
HEADLESS=false

# (ไม่บังคับ) ปรับระดับ Zoom / Scale ของหน้าจอ (เช่น 0.75 สำหรับจอเล็ก 1024x600 หรือ 7 นิ้ว เพื่อให้แสดงผลพอดีไม่ล้นจอ)
# DEVICE_SCALE_FACTOR=0.75

# (ไม่บังคับ) กำหนด DISPLAY เช่น :0 กรณีรันคำสั่งผ่าน SSH
# DISPLAY=:0

# ขนาดหน้าต่างสำหรับโหมด DEBUG Windowed (เช่น 1024x600 สำหรับ ED-MONITOR-101C หรือ 540x960 สำหรับแนวตั้ง)
WINDOW_WIDTH=1024
WINDOW_HEIGHT=600

# หน่วงเวลา Polling ตรวจจับบัตร (วินาที)
POLL_INTERVAL=0.5
