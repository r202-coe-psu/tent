# URL ของ Tent Server (เช่น http://localhost:5173 หรือ https://tent.your-domain.com)
TENT_BASE_URL=http://localhost:5173

# Device ID และ Secret ที่สร้างจากหน้า Back Office (/portal/system-management/scanners)
DEVICE_ID=SCAN-01
DEVICE_SECRET=sk_scan_your_secret_here

# การแสดงผลของ Playwright (chromium, firefox, webkit)
BROWSER=chromium

# DEBUG: true = เปิดเป็นหน้าต่างทั่วไป, false = Kiosk เต็มหน้าจอ
DEBUG=true

# หน่วงเวลา Polling ตรวจจับบัตร (วินาที)
POLL_INTERVAL=0.5
